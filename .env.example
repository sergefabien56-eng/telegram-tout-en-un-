# ---------------------------------------------------------------------------
# TOUT EN UN — variables d'environnement (exemple)
# Copier vers .env.local pour le développement. NE JAMAIS versionner les secrets.
# ---------------------------------------------------------------------------

# Environnement
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base de données PostgreSQL (Neon, Supabase, ou autre)
DATABASE_URL=postgres://user:password@host:5432/tout_en_un?sslmode=require

# Chiffrement AES-256-GCM (32 octets encodés en base64) — clé SEPARÉE de la BDD
# Générer : openssl rand -base64 32
ENCRYPTION_KEY=

# Sessions / JWT
SESSION_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=

# Fichiers (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# IA (MIMI) — optionnel, fournisseur branchable
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Notifications / divers
CRON_SECRET=
